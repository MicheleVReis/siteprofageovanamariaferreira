# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PROFA. GEOVANA (PRODUÇÃO & DESENVOLVIMENTO)
# ==============================================================================
# Este projeto é uma aplicação Single Page Application (SPA) construída com
# React + Vite + TypeScript e estilizada com Tailwind CSS.
#
# Para o funcionamento estático padrão em produção (Vercel, Netlify, Cloudflare Pages, etc.):
# NENHUMA variável de ambiente é estritamente obrigatória para build (`npm run build`).
#
# Abaixo estão as variáveis opcionais/suportadas caso você conecte serviços
# externos (como Gemini AI, backend próprio ou ajustes do servidor Vite).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIÇOS DE IA / GOOGLE GEMINI (OPCIONAL)
# ------------------------------------------------------------------------------
# Chave de API do Google Gemini (se for ativar recursos inteligentes de IA no futuro).
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
# Caso queira expor diretamente ao cliente Vite no frontend (prefixo VITE_):
# VITE_GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. URL BASE DA APLICAÇÃO (OPCIONAL / AMBIENTES CLOUD)
# ------------------------------------------------------------------------------
# URL pública onde a aplicação está hospedada (ex: https://profageovanamariaferreira.com.br).
# Utilizada em metatags canônicas, redirecionamentos ou webhooks.
APP_URL="https://seu-dominio.com.br"
VITE_APP_URL="https://seu-dominio.com.br"

# ------------------------------------------------------------------------------
# 3. BACKEND / BANCO DE DADOS (OPCIONAL CASO MIGRE DO LOCALSTORAGE PARA BACKEND)
# ------------------------------------------------------------------------------
# Atualmente a aplicação utiliza persistência via LocalStorage.
# Caso você conecte um backend Supabase ou REST API:
# VITE_SUPABASE_URL="https://xxxxxx.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."
# VITE_API_BASE_URL="https://api.seu-dominio.com.br"

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÃO DO AMBIENTE / VITE
# ------------------------------------------------------------------------------
# Define o modo de execução: production | development | test
NODE_ENV="production"

# Desativa Hot Module Replacement durante builds ou em ambientes em contêiner
DISABLE_HMR="false"
